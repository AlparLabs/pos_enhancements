<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_clover" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.clover</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="clover_environment"
                       invisible="use_payment_terminal != 'clover_fiserv'"
                       required="use_payment_terminal == 'clover_fiserv'"/>
                <field name="clover_connection_type"
                       invisible="use_payment_terminal != 'clover_fiserv'"
                       required="use_payment_terminal == 'clover_fiserv'"/>
                <field name="clover_bearer_token"
                       password="True"
                       invisible="use_payment_terminal != 'clover_fiserv'"
                       required="use_payment_terminal == 'clover_fiserv'"/>
                <field name="clover_device_id"
                       placeholder="ej. C030UQ12345678"
                       invisible="use_payment_terminal != 'clover_fiserv'"
                       required="use_payment_terminal == 'clover_fiserv'"/>
                <field name="clover_pos_id"
                       placeholder="ej. CAJA_01"
                       invisible="use_payment_terminal != 'clover_fiserv'"
                       required="use_payment_terminal == 'clover_fiserv'"/>
                <field name="clover_merchant_id"
                       placeholder="UUID de comercio (opcional)"
                       invisible="use_payment_terminal != 'clover_fiserv'"/>
                <field name="clover_lan_url"
                       placeholder="https://192.168.1.50:12346"
                       invisible="use_payment_terminal != 'clover_fiserv' or clover_connection_type != 'lan'"
                       required="use_payment_terminal == 'clover_fiserv' and clover_connection_type == 'lan'"/>
                <field name="clover_skip_invoice_screen"
                       invisible="use_payment_terminal != 'clover_fiserv'"/>
                <field name="clover_default_installments"
                       invisible="use_payment_terminal != 'clover_fiserv'"/>
                <div class="mt-2" colspan="2" invisible="use_payment_terminal != 'clover_fiserv'">
                    <button name="action_clover_ping"
                            type="object"
                            string="Probar Conexión (Ping)"
                            class="btn btn-outline-primary"
                            icon="fa-signal"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
