<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_inherit_clover" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.clover</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="clover_card_brand" invisible="not clover_payment_id"/>
                <field name="clover_card_last4" invisible="not clover_payment_id"/>
                <field name="clover_auth_code" invisible="not clover_payment_id"/>
                <field name="clover_installments" invisible="not clover_payment_id"/>
                <field name="clover_transaction_no" invisible="not clover_payment_id"/>
                <field name="clover_reference_id" invisible="not clover_payment_id"/>
                <field name="clover_payment_id" invisible="not clover_payment_id" groups="base.group_no_one"/>
                <field name="clover_external_payment_id" invisible="not clover_payment_id" groups="base.group_no_one"/>
            </xpath>
        </field>
    </record>

    <record id="view_pos_payment_tree_inherit_clover" model="ir.ui.view">
        <field name="name">pos.payment.tree.inherit.clover</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="clover_card_brand" optional="hide"/>
                <field name="clover_card_last4" optional="hide"/>
                <field name="clover_auth_code" optional="hide"/>
                <field name="clover_transaction_no" optional="hide"/>
            </xpath>
        </field>
    </record>
</odoo>
