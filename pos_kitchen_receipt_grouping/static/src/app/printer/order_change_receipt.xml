<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        Hereda de point_of_sale.OrderChangeReceipt (template base de Odoo 19).
        El agrupamiento por categoría lo hace el core vía change.group
        (ver receiptLineGrouper.getGroup en services/pos_store.js);
        acá sólo se ajusta la presentación:
        - Encabezado en español, con el mozo asignado si existe.
        - "Mesa X" en lugar de la referencia de la orden cuando hay mesa.
        - Encabezado de categoría estilo "► CATEGORÍA".
        - Las variantes de producto se muestran en negrita, en la misma línea.
    -->
    <t t-name="pos_kitchen_receipt_grouping.OrderChangeReceipt"
       t-inherit="point_of_sale.OrderChangeReceipt"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o-employee-name')]" position="replace">
            <div class="o-employee-name" style="font-size: 78%;">
                <span><t t-esc="data.config_name"/> : <t t-esc="data.time"/></span><br/>
                <span>Por: <t t-esc="data.employee_name"/></span>
                <t t-if="data.waiter_name">
                    <br/><span>Mozo: <strong><t t-esc="data.waiter_name"/></strong></span>
                </t>
            </div>
        </xpath>
        <xpath expr="//span[hasclass('my-4')]" position="replace">
            <span class="my-4" style="font-size: 150%;">
                <t t-if="data.table_name">Mesa <strong><t t-esc="data.table_name"/></strong></t>
                <t t-else="">
                    <span class="order-ref-prefix">Orden </span><strong><t t-esc="data.pos_reference"/></strong>
                </t>
                <strong t-if="data.tracking_number" class="fw-light my-3">
                    # <t t-esc="data.tracking_number"/>
                </strong>
            </span>
        </xpath>
        <xpath expr="//div[@t-foreach='data.changes.groupedData']/div[1]" position="replace">
            <div class="pos-receipt-title text-center mb-1"
                 style="font-size: 130%; border-bottom: 2px solid black; font-weight: bold; padding: 2px 0; letter-spacing: 0.05rem;">
                &#9658; <t t-esc="group.name"/>
            </div>
        </xpath>
    </t>

    <t t-name="pos_kitchen_receipt_grouping.OrderChangeReceiptLine"
       t-inherit="point_of_sale.OrderChangeReceiptLine"
       t-inherit-mode="extension">
        <xpath expr="//div[1]" position="attributes">
            <attribute name="style">font-size: 110%;</attribute>
        </xpath>
        <!--
            Las variantes van DENTRO del span product-name (antes eran items flex
            hermanos, y cada una se comprimia en su propia columna angosta).
            El contenedor sigue siendo d-flex a proposito: core declara
            `.product-name { display: -webkit-box; -webkit-box-orient: vertical; }`
            (product_card.scss), que es un display de nivel bloque. Fuera de un
            contenedor flex ese span arranca en su propia linea y la cantidad
            queda impresa arriba del nombre. El d-flex lo convierte en item flex
            y los deja en la misma linea; min-width:0 evita que un nombre largo
            desborde los 512px del render de impresion.
        -->
        <xpath expr="//div[hasclass('d-flex')]" position="replace">
            <div class="d-flex medium">
                <span class="me-2" style="flex: 0 0 auto;" t-esc="line.quantity"/>
                <span class="product-name" style="flex: 1 1 auto; min-width: 0;">
                    <t t-esc="line.basic_name"/>
                    <t t-if="line.attribute_value_names?.length">
                        <t t-foreach="line.attribute_value_names" t-as="attr" t-key="attr_index">
                            <strong> (<t t-esc="attr"/>)</strong>
                        </t>
                    </t>
                </span>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('ms-5')]" position="replace"/>
    </t>
</templates>
