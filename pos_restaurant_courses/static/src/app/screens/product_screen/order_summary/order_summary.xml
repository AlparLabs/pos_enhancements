<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_courses.OrderWidget" t-inherit="point_of_sale.OrderWidget" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('order-container')]" position="replace">
            <div class="order-container flex-grow-1 overflow-y-auto">
                <t t-if="pos.config.module_pos_restaurant and pos.getOrder()?.hasCourses()">
                    <t t-foreach="pos.getOrder().courses" t-as="course" t-key="course.uuid">
                        <OrderCourse course="course" course_index="course_index">
                            <t t-slot-scope="course_scope">
                                <Orderline line="course_scope.line" />
                            </t>
                        </OrderCourse>
                    </t>
                </t>
                <t t-else="">
                    <t t-foreach="props.lines" t-as="line" t-key="line.id">
                        <Orderline line="line" />
                    </t>
                </t>
            </div>
        </xpath>
    </t>
</templates>
