<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_courses.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons')]" position="inside">
            <button class="control-button btn btn-light rounded-0 fw-bolder" 
                    t-if="pos.config.module_pos_restaurant and !pos.getOrder()?.isRefund" 
                    t-on-click="() => pos.addCourse()">
                <i class="fa fa-plus me-1"/>
                <span>Course</span>
            </button>
        </xpath>
    </t>
</templates>
