<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_course_view_form" model="ir.ui.view">
        <field name="name">pos.course.view.form</field>
        <field name="model">pos.course</field>
        <field name="arch" type="xml">
            <form string="POS Course">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                    </group>
                    <notebook>
                        <page string="Categories" name="categories">
                            <field name="category_ids">
                                <list>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="pos_course_view_tree" model="ir.ui.view">
        <field name="name">pos.course.view.list</field>
        <field name="model">pos.course</field>
        <field name="arch" type="xml">
            <list string="POS Courses" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="pos_course_action" model="ir.actions.act_window">
        <field name="name">Courses</field>
        <field name="res_model">pos.course</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_pos_course"
              name="Courses"
              parent="point_of_sale.menu_point_config_product"
              action="pos_course_action"
              sequence="20"/>
</odoo>
