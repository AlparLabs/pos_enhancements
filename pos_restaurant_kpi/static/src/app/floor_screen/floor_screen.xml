<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="pos_restaurant.FloorScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('floor-selector')]" position="after">
            <div class="kpi-bar d-flex gap-4 p-2 align-items-center bg-light border-start">
                <div class="kpi-item d-flex flex-column align-items-center px-3">
                    <span class="text-muted smaller fw-bolder text-uppercase" style="font-size: 0.7rem;">Customers</span>
                    <span class="fs-4 fw-bolder text-primary" t-esc="totalCustomers"/>
                </div>
                <div class="kpi-item d-flex flex-column align-items-center px-3">
                    <span class="text-muted smaller fw-bolder text-uppercase" style="font-size: 0.7rem;">Avg. Consumption</span>
                    <span class="fs-4 fw-bolder text-success" t-esc="pos.format_currency(avgConsumption)"/>
                </div>
            </div>
        </xpath>
    </t>
</templates>
