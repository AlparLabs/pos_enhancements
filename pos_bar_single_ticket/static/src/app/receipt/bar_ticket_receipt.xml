<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_bar_single_ticket.BarTicketReceipt">
        <div class="pos-receipt" t-att-style="receiptStyle">
            <!--
                Marca de agua en las cuatro esquinas. Va como <svg><text> con
                fill="none" y stroke, y no con -webkit-text-stroke, porque la
                impresion serializa el DOM a un <foreignObject> via html-to-image:
                el stroke de SVG sobrevive esa conversion, la propiedad -webkit-
                no esta garantizada y la letra saldria rellena en negro.
            -->
            <t t-if="watermark">
                <t t-set="wm" t-value="watermarkMetrics"/>
                <svg width="110" t-att-height="wm.height" t-attf-viewBox="0 0 110 {{wm.height}}" style="position: absolute; top: 6px; left: 8px; overflow: visible;">
                    <text x="0" t-att-y="wm.y" text-anchor="start" t-att-font-size="wm.fontSize" font-weight="bold" fill="none" stroke="black" t-att-stroke-width="wm.strokeWidth" t-esc="watermark"/>
                </svg>
                <svg width="110" t-att-height="wm.height" t-attf-viewBox="0 0 110 {{wm.height}}" style="position: absolute; top: 6px; right: 8px; overflow: visible;">
                    <text x="110" t-att-y="wm.y" text-anchor="end" t-att-font-size="wm.fontSize" font-weight="bold" fill="none" stroke="black" t-att-stroke-width="wm.strokeWidth" t-esc="watermark"/>
                </svg>
                <svg width="110" t-att-height="wm.height" t-attf-viewBox="0 0 110 {{wm.height}}" style="position: absolute; bottom: 6px; left: 8px; overflow: visible;">
                    <text x="0" t-att-y="wm.y" text-anchor="start" t-att-font-size="wm.fontSize" font-weight="bold" fill="none" stroke="black" t-att-stroke-width="wm.strokeWidth" t-esc="watermark"/>
                </svg>
                <svg width="110" t-att-height="wm.height" t-attf-viewBox="0 0 110 {{wm.height}}" style="position: absolute; bottom: 6px; right: 8px; overflow: visible;">
                    <text x="110" t-att-y="wm.y" text-anchor="end" t-att-font-size="wm.fontSize" font-weight="bold" fill="none" stroke="black" t-att-stroke-width="wm.strokeWidth" t-esc="watermark"/>
                </svg>
            </t>
            <div class="pos-receipt-title text-center my-2" style="font-size: 115%; font-weight: bold;">
                <t t-esc="posName" />
            </div>

            <hr class="my-2" style="border-top: 2px dashed black;"/>

            <!-- Single isolated unit of the order line -->
            <div class="pos-receipt-title my-2 text-center">
                <span style="font-size: 100%; font-weight: bold;">1 x <t t-esc="productName"/></span>
                <div t-foreach="lotNames" t-as="lot" t-key="lot_index" style="font-size: 70%;">
                    Lot: <t t-esc="lot"/>
                </div>
            </div>

            <hr class="my-2" style="border-top: 2px dashed black;"/>

            <div class="pos-receipt-title text-center mt-1 mb-2">
                <div t-esc="dateStr" />
                <!-- Odoo receipt number of the sale, to tie the bar ticket to the order -->
                <div t-if="orderReference" style="font-weight: bold;">Ticket: <t t-esc="orderReference"/></div>
            </div>
            <!-- Extra padding to prevent the printer from cutting off the order number -->
            <br/>
            <br/>
        </div>
    </t>
</templates>
