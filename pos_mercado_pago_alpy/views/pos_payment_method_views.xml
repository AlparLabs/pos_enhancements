<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_pos_mercado_pago" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.mercado_pago</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <!-- ── Campos comunes a todos los métodos Mercado Pago ── -->
                <field name="mp_bearer_token"
                    placeholder="APP_USR-..."
                    invisible="use_payment_terminal not in ('mercado_pago_alpy', 'mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"
                    required="use_payment_terminal in ('mercado_pago_alpy', 'mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"/>
                <field name="mp_webhook_secret_key"
                    placeholder="c2f3662..."
                    invisible="use_payment_terminal not in ('mercado_pago_alpy', 'mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"/>

                <!-- ── Terminal Smart ── -->
                <field name="mp_id_point_smart"
                    placeholder="1494126963"
                    invisible="use_payment_terminal != 'mercado_pago_alpy'"
                    required="use_payment_terminal == 'mercado_pago_alpy'"/>
                <button string="Force PDV" type="object" name="force_pdv"
                    groups="base.group_no_one"
                    class="oe_highlight"
                    invisible="use_payment_terminal != 'mercado_pago_alpy'"/>

                <!-- ── QR (Local / Pantalla / Híbrido) ── -->
                <field name="mp_user_id"
                    placeholder="123456789"
                    invisible="use_payment_terminal not in ('mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"
                    required="use_payment_terminal in ('mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"/>
                <field name="mp_external_pos_id"
                    placeholder="CAJA01"
                    invisible="use_payment_terminal not in ('mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"
                    required="use_payment_terminal in ('mercado_pago_qr_local', 'mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"/>
                <field name="mp_qr_string"
                    placeholder="https://mpago.la/..."
                    invisible="use_payment_terminal not in ('mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"
                    required="use_payment_terminal in ('mercado_pago_qr_screen', 'mercado_pago_qr_hybrid')"/>
            </xpath>
        </field>
    </record>
</odoo>