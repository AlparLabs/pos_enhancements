<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_mercado_pago_alpy.MercadoPagoQrPopup">
        <div class="popup popup-qr">
            <div class="modal-header d-flex justify-content-center flex-column align-items-center">
                <h4 class="modal-title">Escanea para Pagar con Mercado Pago</h4>
            </div>
            <div class="modal-body text-center d-flex flex-column align-items-center justify-content-center">
                <p>Monto: <t t-esc="props.formatCurrency(props.amount)"/></p>
                <!-- Render the QR Code here -->
                <div class="qr-container mx-auto my-4 p-4 bg-white rounded shadow-sm" style="width: 250px; height: 250px;">
                    <img t-att-src="qrCodeUrl" alt="Mercado Pago QR Code" style="width: 100%; height: 100%; object-fit: contain;"/>
                </div>
                <!-- Status text for polling -->
                <p class="mt-3 font-weight-bold text-success" t-if="state.status == 'approved'">¡Pago completado! Imprimiendo recibo...</p>
                <p class="mt-3 text-muted" t-else="">Esperando pago... <i class="fa fa-spinner fa-spin"></i></p>
            </div>
            <div class="modal-footer justify-content-center">
                <button class="btn btn-secondary" t-on-click="cancel">
                    Atrás
                </button>
            </div>
        </div>
    </t>
</templates>
