<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- ── Component template ──────────────────────────────────────────────── -->
    <t t-name="pos_restaurant_table_status.TableStatusButton" owl="1">
        <button
            t-if="isVisible"
            class="btn btn-secondary btn-lg py-5"
            t-att-class="{ 'btn-success': isVerified, 'btn-secondary': !isVerified }"
            t-on-click="() => this.click()"
        >
            <i t-att-class="isVerified ? 'fa fa-check-circle me-2' : 'fa fa-circle-o me-2'"/>
            <span t-esc="isVerified ? 'Verificado' : 'Verificar Mesa'"/>
        </button>
    </t>

    <!-- ── Inject into the ControlButtons actions dialog ──────────────────── -->
    <t t-name="pos_restaurant_table_status.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <TableStatusButton/>
        </xpath>
    </t>

</templates>
