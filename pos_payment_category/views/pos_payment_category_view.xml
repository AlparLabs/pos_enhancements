<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- POS Payment Category Form View -->
    <record id="pos_payment_category_view_form" model="ir.ui.view">
        <field name="name">pos.payment.category.form</field>
        <field name="model">pos.payment.category</field>
        <field name="arch" type="xml">
            <form string="Payment Category">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="active" invisible="1"/>
                            <field name="color" widget="color_picker"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="payment_method_ids" widget="many2many_tags" readonly="1"/>
                            <field name="config_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POS Payment Category Tree View -->
    <record id="pos_payment_category_view_tree" model="ir.ui.view">
        <field name="name">pos.payment.category.tree</field>
        <field name="model">pos.payment.category</field>
        <field name="arch" type="xml">
            <list string="Payment Categories" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- POS Payment Category Action -->
    <record id="action_pos_payment_category" model="ir.actions.act_window">
        <field name="name">Payment Categories</field>
        <field name="res_model">pos.payment.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new point of sale payment category
            </p>
            <p>
                Group your payment methods into categories to keep your POS screen organized.
            </p>
        </field>
    </record>

    <!-- Menu Item under POS Configuration -->
    <menuitem id="menu_pos_payment_category"
              name="Payment Categories"
              parent="point_of_sale.menu_point_config_product"
              action="action_pos_payment_category"
              sequence="15"/>

    <!-- Inherit pos.payment.method to add category_id -->
    <record id="pos_payment_method_view_form_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.category</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="category_id"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit pos.payment.method tree to show category_id -->
    <record id="pos_payment_method_view_tree_inherit" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.inherit.category</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="category_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit pos.payment tree to show category_id -->
    <record id="view_pos_payment_tree_inherit_category" model="ir.ui.view">
        <field name="name">pos.payment.tree.inherit.category</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="category_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit pos.payment form to show category_id -->
    <record id="view_pos_payment_form_inherit_category" model="ir.ui.view">
        <field name="name">pos.payment.form.inherit.category</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_method_id']" position="after">
                <field name="category_id"/>
            </xpath>
        </field>
    </record>

    <!-- Inherit pos.config form to configure payment categories per POS -->
    <record id="pos_config_view_form_inherit_payment_category" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.payment.category</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='row mt16 o_settings_container'][last()]" position="after">
                <div class="row mt16 o_settings_container">
                    <div class="o_setting_box col-xs-12 col-md-6">
                        <div class="o_setting_left_pane"/>
                        <div class="o_setting_right_pane">
                            <label for="payment_category_ids" string="Payment Categories"/>
                            <div class="text-muted">
                                Payment categories available on this POS screen.
                            </div>
                            <div class="content-group mt8">
                                <field name="payment_category_ids" widget="many2many_tags"
                                       options="{'no_create': True}"
                                       placeholder="Select payment categories..."/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>

