<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Inherit Payment Screen to inject category buttons before payment methods -->
    <t t-name="pos_payment_category.PaymentScreen" t-inherit="point_of_sale.PaymentScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods')]" position="before">
            <!-- Breadcrumbs / Back button when a Category is open -->
            <div t-if="state.activePaymentCategory" class="d-flex align-items-center mb-3">
                <button class="btn btn-secondary me-2 fs-5" t-on-click="() => this.clickPaymentCategory(state.activePaymentCategory)">
                    <i class="fa fa-arrow-left me-2"/> 
                    Back
                </button>
                <span class="fs-4 fw-bold">
                    <t t-esc="state.activePaymentCategory.name"/>
                </span>
            </div>

            <!-- Top Level Payment Categories View -->
            <div t-if="!state.activePaymentCategory" class="payment-category-container d-flex flex-wrap gap-2 mb-3">
                <t t-foreach="paymentCategories" t-as="category" t-key="category.id">
                    <button 
                        class="btn btn-primary d-flex align-items-center justify-content-center fw-bolder" 
                        style="height: 60px; min-width: 150px; font-size: 1.1rem;"
                        t-on-click="() => this.clickPaymentCategory(category)">
                        <i class="fa fa-folder-open me-2"/>
                        <t t-esc="category.name" />
                    </button>
                </t>
            </div>
        </xpath>
    </t>
</templates>
