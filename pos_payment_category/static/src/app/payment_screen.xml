<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Inherit Payment Screen Methods to inject category buttons before payment methods -->
    <t t-name="pos_payment_category.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('paymentmethods')]" position="before">
            <!-- Breadcrumbs / Back button when a Category is open -->
            <div t-if="state.activePaymentCategory" class="d-flex align-items-center mb-4 text-primary" style="cursor: pointer;" t-on-click="() => this.clickPaymentCategory(state.activePaymentCategory)">
                <i class="fa fa-arrow-left me-2 fs-5 text-dark"/>
                <span class="fs-5 me-2 text-dark">Regresar</span>
                <span class="fs-5 fw-bold text-dark"><t t-esc="state.activePaymentCategory.name"/></span>
            </div>

            <!-- Top Level Payment Categories View -->
            <div t-if="!state.activePaymentCategory" class="paymentmethods d-flex flex-column gap-2 mb-3">
                <t t-foreach="paymentCategories" t-as="category" t-key="category.id">
                    <button 
                        class="btn btn-light d-flex align-items-center bg-white border rounded p-3 text-start mt-2 shadow-sm"
                        style="cursor: pointer; transition: all 0.2s ease-in-out;"
                        t-on-click="() => this.clickPaymentCategory(category)">
                        <div class="border d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 30px; border-radius: 4px;">
                            <i class="fa fa-folder text-dark" style="font-size: 1.2rem;"/>
                        </div>
                        <span class="fw-bold fs-5 text-dark" style="font-family: 'Odoo Unicode Support Noto', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;">
                            <t t-esc="category.name" />
                        </span>
                    </button>
                </t>
            </div>
        </xpath>
        
        <!-- Replace the loop array to use our new filtered getter -->
        <xpath expr="//t[@t-foreach='payment_methods_from_config']" position="attributes">
            <attribute name="t-foreach">displayedPaymentMethods</attribute>
        </xpath>
    </t>
</templates>
