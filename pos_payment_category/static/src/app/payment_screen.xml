<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_category.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">

        <!-- Breadcrumb / back button shown when a category is open -->
        <xpath expr="//div[hasclass('paymentmethods')]" position="before">
            <div t-if="this.categoryState.activePaymentCategory" class="d-flex align-items-center mb-4" style="cursor: pointer;" t-on-click="() => this.clickPaymentCategory(this.categoryState.activePaymentCategory)">
                <i class="fa fa-arrow-left me-2 fs-5 text-dark"/>
                <span class="fs-5 me-2 text-dark">Regresar</span>
                <span class="fs-5 fw-bold text-dark"><t t-esc="this.categoryState.activePaymentCategory.name"/></span>
            </div>
        </xpath>

        <!-- Point the methods loop at our filtered list.
             Match by the exact t-foreach value used by Odoo 19.0
             ("payment_methods_from_config", without "this."). A structural
             predicate like /t[@t-foreach] is NOT located by QWeb's inheritance
             engine and breaks the whole template, so we match by value. -->
        <xpath expr="//t[@t-foreach='payment_methods_from_config']" position="attributes">
            <attribute name="t-foreach">filteredPaymentMethods</attribute>
        </xpath>

        <!-- Hide the native payment-method button for category folder objects,
             preserving the original minimal-cashier / pay_later guard. -->
        <xpath expr="//div[hasclass('paymentmethod')]" position="attributes">
            <attribute name="t-if">!paymentMethod.is_category and !(this.pos.cashier._role === 'minimal' and paymentMethod.type === 'pay_later')</attribute>
        </xpath>

        <!-- Render a folder button for each category object -->
        <xpath expr="//div[hasclass('paymentmethod')]" position="before">
            <t t-if="paymentMethod.is_category">
                <button
                    class="button paymentmethod btn btn-light btn-lg lh-lg flex-fill d-flex align-items-center gap-2"
                    t-on-click="() => this.clickPaymentCategory(paymentMethod)">
                    <i class="fa fa-folder text-muted"/>
                    <span class="fw-bold"><t t-esc="paymentMethod.name"/></span>
                </button>
            </t>
        </xpath>

    </t>
</templates>
