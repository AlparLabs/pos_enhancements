<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_category.PaymentScreenMethods" t-inherit="point_of_sale.PaymentScreenMethods" t-inherit-mode="extension">

        <!-- Back button breadcrumb when a category is open -->
        <xpath expr="//div[hasclass('paymentmethods')]" position="before">
            <div t-if="categoryState.activePaymentCategory" class="d-flex align-items-center mb-4 text-primary" style="cursor: pointer;" t-on-click="() => this.clickPaymentCategory(categoryState.activePaymentCategory)">
                <i class="fa fa-arrow-left me-2 fs-5 text-dark"/>
                <span class="fs-5 me-2 text-dark">Regresar</span>
                <span class="fs-5 fw-bold text-dark"><t t-esc="categoryState.activePaymentCategory.name"/></span>
            </div>
        </xpath>

        <!-- Replace the foreach to use our filtered list.
             Odoo 19 uses "this.payment_methods_from_config" (with "this.") — must match exactly. -->
        <xpath expr="//t[@t-foreach='this.payment_methods_from_config']" position="attributes">
            <attribute name="t-foreach">this.filteredPaymentMethods</attribute>
        </xpath>

        <!-- Render a folder button for category items.
             The native paymentmethod div is hidden for categories via showPaymentMethod() override in JS. -->
        <xpath expr="//div[hasclass('paymentmethod')]" position="before">
            <t t-if="paymentMethod.is_category">
                <button
                    class="button paymentmethod btn btn-light btn-lg lh-lg flex-fill d-flex align-items-center gap-2"
                    t-on-click="() => this.clickPaymentCategory(paymentMethod)">
                    <i class="fa fa-folder text-muted"/>
                    <span class="fw-bold"><t t-esc="paymentMethod.name"/></span>
                </button>
            </t>
        </xpath>

    </t>
</templates>
