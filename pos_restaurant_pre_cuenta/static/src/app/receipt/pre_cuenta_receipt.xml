<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_pre_cuenta.PreCuentaReceipt" owl="1">
        <t t-set="order" t-value="props.order"/>
        <div class="pos-receipt">

            <ReceiptHeader order="order"/>

            <div class="pos-receipt-center-align"
                 style="font-weight: bold; font-size: 1.5em; margin: 10px 0 2px;">
                PRE-CUENTA
            </div>
            <div class="pos-receipt-center-align"
                 style="font-size: 0.85em; margin-bottom: 10px; color: #666;">
                No válido como factura
            </div>

            <t t-if="order.tracking_number">
                <div class="pos-receipt-center-align"
                     style="font-size: 2em; font-weight: bold; margin: 6px 0;">
                    <t t-esc="order.tracking_number"/>
                </div>
            </t>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <div class="pos-receipt-center-align" style="margin: 8px 0;">
                <t t-if="order.table_id">
                    <div style="font-size: 1.15em; font-weight: bold;">
                        Mesa: <t t-esc="order.table_id.getName()"/>
                    </div>
                </t>
                <t t-if="order.customer_count">
                    <div style="font-size: 1em; font-weight: bold;">
                        Comensales: <t t-esc="order.customer_count"/>
                    </div>
                </t>
                <t t-if="order.waiter_id">
                    <div style="font-size: 1em; font-weight: bold; margin-top: 4px;">
                        Mozo: <t t-esc="order.waiter_id.name"/>
                    </div>
                </t>
            </div>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <t t-if="order.partner_id">
                <div class="pos-receipt-contact" style="margin-bottom: 6px;">
                    Cliente: <t t-esc="order.partner_id.name"/>
                </div>
            </t>

            <!-- Orderlines -->
            <div class="orderlines">
                <t t-foreach="order.lines" t-as="line" t-key="line.uuid">
                    <Orderline line="line" mode="'receipt'"/>
                </t>
            </div>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <!-- Total -->
            <div class="pos-receipt-amount" style="font-size: 1.2em;">
                TOTAL
                <span class="pos-receipt-right-align"
                      t-esc="formatCurrency(order.priceIncl)"/>
            </div>

            <t t-if="order.config.receipt_footer">
                <div class="pos-receipt-center-align"
                     style="margin-top: 16px; font-size: 0.85em; white-space: pre-line;">
                    <t t-esc="order.config.receipt_footer"/>
                </div>
            </t>

            <div style="height: 20px; width: 100%;"/>

        </div>
    </t>
</templates>
