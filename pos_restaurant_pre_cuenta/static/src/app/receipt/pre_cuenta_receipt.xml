<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_restaurant_pre_cuenta.PreCuentaReceipt" owl="1">
        <t t-set="order" t-value="props.order"/>
        <div class="pos-receipt">

            <ReceiptHeader order="order"/>

            <div class="pos-receipt-center-align"
                 style="font-weight: bold; font-size: 1.5em; margin: 10px 0 2px;">
                PRE-CUENTA
            </div>
            <div class="pos-receipt-center-align"
                 style="font-size: 0.85em; margin-bottom: 10px; color: #666;">
                No válido como factura
            </div>

            <t t-if="order.tracking_number">
                <div class="pos-receipt-center-align"
                     style="font-size: 2em; font-weight: bold; margin: 6px 0;">
                    <t t-esc="order.tracking_number"/>
                </div>
            </t>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <div class="pos-receipt-center-align" style="margin: 8px 0;">
                <t t-if="order.table_id">
                    <div style="font-size: 1.15em; font-weight: bold;">
                        Mesa: <t t-esc="order.table_id.getName()"/>
                    </div>
                </t>
                <t t-if="order.customer_count">
                    <div style="font-size: 1em; font-weight: bold;">
                        Comensales: <t t-esc="order.customer_count"/>
                    </div>
                </t>
                <t t-if="order.waiter_id">
                    <div style="font-size: 1em; font-weight: bold; margin-top: 4px;">
                        Mozo: <t t-esc="order.waiter_id.name"/>
                    </div>
                </t>
            </div>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <t t-if="order.partner_id">
                <div class="pos-receipt-contact" style="margin-bottom: 6px;">
                    Cliente: <t t-esc="order.partner_id.name"/>
                </div>
            </t>

            <!--
                Orderlines. Los hijos de un combo se filtran: en la pre-cuenta
                el mozo solo necesita ver el nombre del combo con su importe.
                El core los imprimiria indentados y sin precio (OrderDisplay
                .comboSortedLines + Orderline, que pone price: false cuando hay
                combo_parent_id). Filtrar aca alcanza porque Orderline no es
                recursivo, y la linea padre ya muestra el total agregado del
                combo via displayPrice.
            -->
            <div class="orderlines">
                <t t-foreach="order.lines.filter((l) => !l.combo_parent_id)" t-as="line" t-key="line.uuid">
                    <Orderline line="line" mode="'receipt'"/>
                </t>
            </div>

            <div style="border-top: 1px dashed #ccc; margin: 8px 0;"/>

            <!-- Total -->
            <div class="pos-receipt-amount" style="font-size: 1.2em;">
                TOTAL
                <span class="pos-receipt-right-align"
                      t-esc="formatCurrency(order.priceIncl)"/>
            </div>

            <!-- Sugerencias de propina -->
            <t t-if="tipSuggestions and tipSuggestions.length">
                <div class="pos-receipt-tip-suggestions" style="margin-top: 12px; padding-top: 8px; border-top: 1px dashed #ccc;">
                    <div class="pos-receipt-center-align" style="font-weight: bold; font-size: 0.95em; margin-bottom: 6px;">
                        Propina sugerida:
                    </div>
                    <div class="d-flex flex-nowrap justify-content-around">
                        <t t-foreach="tipSuggestions" t-as="tip" t-key="tip.percentage">
                            <div class="d-flex flex-column align-items-center flex-grow-1" style="text-align: center;">
                                <div style="font-weight: bold; font-size: 1.05em;"><t t-esc="tip.label"/></div>
                                <div style="font-size: 0.95em; margin-top: 2px;"><t t-esc="tip.amount"/></div>
                                <div class="text-muted" style="font-size: 0.75em; margin-top: 1px;">
                                    (<t t-esc="tip.totalWithTip"/>)
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>

            <!-- Encuesta NPS (si está habilitada para pre-cuenta) -->
            <t t-if="npsSurveyEnabled">
                <div class="pos-receipt-center-align nps-survey-qr-container" style="text-align: center; margin-top: 14px; margin-bottom: 8px; padding-top: 8px; border-top: 1px dashed #ccc;">
                    <div t-if="npsReceiptTitle" class="nps-survey-title" style="font-weight: bold; font-size: 0.95em; margin-bottom: 5px;">
                        <t t-esc="npsReceiptTitle"/>
                    </div>
                    <div class="nps-survey-qr-image" style="margin: 5px 0;">
                        <img t-att-src="npsSurveyQrCodeSrc" style="width: 140px; height: 140px;" alt="NPS Survey QR"/>
                    </div>
                    <div t-if="npsReceiptSubtitle" class="nps-survey-subtitle" style="font-size: 0.8em; margin-top: 5px; color: #555;">
                        <t t-esc="npsReceiptSubtitle"/>
                    </div>
                </div>
            </t>

            <t t-if="order.config.receipt_footer">
                <div class="pos-receipt-center-align"
                     style="margin-top: 16px; font-size: 0.85em; white-space: pre-line;">
                    <t t-esc="order.config.receipt_footer"/>
                </div>
            </t>

            <div style="height: 20px; width: 100%;"/>

        </div>
    </t>
</templates>
