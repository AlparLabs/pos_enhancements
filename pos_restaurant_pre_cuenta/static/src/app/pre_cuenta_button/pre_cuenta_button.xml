<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_pre_cuenta.PreCuentaButton" owl="1">
        <button t-if="isVisible"
                class="control-button o_pre_cuenta_button"
                t-att-class="props.buttonClass"
                t-att-disabled="!currentOrder or currentOrder.isEmpty()"
                t-on-click="() => this.click()">
            <i class="fa fa-print me-1" role="img" aria-label="Pre-cuenta" title="Pre-cuenta"/>
            <span>Pre-cuenta</span>
        </button>
    </t>

    <t t-name="pos_restaurant_pre_cuenta.ActionpadWidget"
       t-inherit="point_of_sale.ActionpadWidget"
       t-inherit-mode="extension">
        <xpath expr="//button[hasclass('submit-order')]" position="attributes">
            <attribute name="class" remove="w-50" separator=" "/>
        </xpath>
        <xpath expr="//button[hasclass('pay-order-button-restaurant')]" position="attributes">
            <attribute name="class" add="flex-fill" remove="w-50" separator=" "/>
        </xpath>
        <xpath expr="//button[hasclass('pay-order-button-restaurant')]" position="before">
            <PreCuentaButton buttonClass="'button btn btn-secondary btn-lg flex-fill d-flex align-items-center justify-content-center'"/>
        </xpath>
    </t>

</templates>
