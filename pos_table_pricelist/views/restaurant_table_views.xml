<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="restaurant_table_form_inherit_pos_pricelist" model="ir.ui.view">
        <field name="name">restaurant.table.form.inherit.pos.pricelist</field>
        <field name="model">restaurant.table</field>
        <field name="inherit_id" ref="pos_restaurant.view_restaurant_table_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='color']" position="after">
                <field
                    name="pos_pricelist_id"
                    string="Lista de precios POS"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
