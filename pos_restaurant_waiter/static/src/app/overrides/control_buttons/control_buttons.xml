<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_restaurant_waiter.ChangeWaiterButton" owl="1">
        <button t-if="isVisible"
                class="btn btn-secondary btn-lg py-5"
                t-on-click="() => this.click()">
            <i class="fa fa-user me-2"/>
            <t t-if="currentWaiterName">
                <span t-esc="currentWaiterName"/>
            </t>
            <t t-else="">
                <span>Assign Waiter</span>
            </t>
        </button>
    </t>

    <t t-name="pos_restaurant_waiter.ControlButtons"
       t-inherit="point_of_sale.ControlButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <ChangeWaiterButton/>
        </xpath>
    </t>

</templates>
