<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_pos_form_waiter" model="ir.ui.view">
        <field name="name">pos.order.form.waiter</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="waiter_id" string="Waiter"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_tree_waiter" model="ir.ui.view">
        <field name="name">pos.order.tree.waiter</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_tree"/>
        <field name="arch" type="xml">
            <field name="employee_id" position="after">
                <field name="waiter_id" string="Waiter" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_pos_order_search_waiter" model="ir.ui.view">
        <field name="name">pos.order.search.waiter</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//separator" position="after">
                <field name="waiter_id" string="Waiter"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Waiter" name="group_by_waiter" domain="[]" context="{'group_by': 'waiter_id'}"/>
            </xpath>
        </field>
    </record>
</odoo>
