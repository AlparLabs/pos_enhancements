<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <!-- Hide the total price div if it's a combo subproduct.
             line.comboParent is already exposed by the core Orderline   template. -->
        <xpath expr="//div[hasclass('product-price')]" position="attributes">
            <attribute name="t-if">!props.basic_receipt and !line.comboParent</attribute>
        </xpath>

        <!-- Hide the unit price / qty row if it's a combo subproduct -->
        <xpath expr="//li[hasclass('price-per-unit')]" position="attributes">
            <attribute name="t-if">!line.comboParent</attribute>
        </xpath>
    </t>
</templates>
