<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_invoice_document_delivery" inherit_id="account.report_invoice_document">
        <xpath expr="//div[@id='informations']" position="before">
            <t t-if="o.has_pos_delivery_customer_details()">
                <div t-if="o.partner_id.phone or o.partner_id.mobile or o.partner_id.email" class="row mb-3 p-2" style="background-color: #f8f9fa; border: 1px solid #dee2e6; border-radius: 4px;">
                    <div class="col-12 mb-1">
                        <strong class="text-uppercase" style="font-size: 0.85em; color: #6c757d;">Datos de Entrega / Contacto</strong>
                    </div>
                    <div class="col-6" t-if="o.partner_id.phone or o.partner_id.mobile">
                        <strong>Teléfono: </strong><span t-out="o.partner_id.phone or o.partner_id.mobile"/>
                    </div>
                    <div class="col-6" t-if="o.partner_id.email">
                        <strong>Email: </strong><span t-field="o.partner_id.email"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
