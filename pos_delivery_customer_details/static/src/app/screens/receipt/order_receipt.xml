<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!-- Destacar datos del cliente (nombre, dirección) e imprimir teléfono en tickets de venta / recibos proforma -->
    <t t-name="pos_delivery_customer_details.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-customer')]" position="replace">
            <t t-set="customer_phone" t-value="order.partner_id.phone or order.partner_id.mobile"/>
            <div t-if="order.partner_id" class="pos-receipt-customer text-center mt-2 mb-2 p-1" style="line-height: 1.35;">
                <div t-if="order.partner_id.name" class="fw-bolder" style="font-size: 1.5em; margin-bottom: 2px;">
                    <t t-if="order.partner_id.parent_name">
                        <span t-esc="order.partner_id.parent_name" />,
                    </t>
                    <span t-esc="order.partner_id.name" />
                </div>
                <div t-if="order.partner_id.pos_contact_address" style="font-size: 1.2em; font-weight: 500;">
                    <span t-esc="order.partner_id.pos_contact_address" />
                </div>
                <div t-if="customer_phone" class="pos-receipt-customer-phone fw-bolder" style="font-size: 1.35em; margin-top: 3px;">
                    <span>Tel: </span><span t-esc="customer_phone" />
                </div>
                <div t-if="order.partner_id.email" style="font-size: 1.1em;">
                    <span>Email: </span><span t-esc="order.partner_id.email" />
                </div>
                <div t-if="order.partner_id.vat" style="font-size: 1.1em;">
                    <span t-esc="order.partner_id.vat" />
                </div>
            </div>
        </xpath>
    </t>
</templates>
