<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_delivery_customer_details.OrderChangeReceipt" t-inherit="point_of_sale.OrderChangeReceipt" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('my-4')]" position="after">
            <t t-set="delivery_customer" t-value="data?.delivery_customer or changes?.delivery_customer"/>
            <t t-if="delivery_customer">
                <div class="pos-kitchen-delivery-customer text-start my-2 p-2"
                     style="font-size: 105%; border: 2px dashed black; line-height: 1.3;">
                    <div style="font-weight: bold; font-size: 1.15em; text-align: center; border-bottom: 1px dashed black; padding-bottom: 3px; margin-bottom: 4px; letter-spacing: 0.05rem;">
                        DATOS DE ENTREGA
                    </div>
                    <div style="font-size: 1.35em; font-weight: bold; margin-bottom: 2px;">
                        <span>Cliente: </span><t t-esc="delivery_customer.name"/>
                    </div>
                    <div t-if="delivery_customer.street" style="font-size: 1.15em; font-weight: 500;">
                        <span>Dirección: </span><t t-esc="delivery_customer.street"/>
                    </div>
                    <div t-if="delivery_customer.city_state_zip" style="font-size: 1.1em;">
                        <span>Localidad: </span><t t-esc="delivery_customer.city_state_zip"/>
                    </div>
                    <div t-if="delivery_customer.phone" style="font-size: 1.35em; font-weight: bold; margin-top: 3px;">
                        <span>Tel: </span><t t-esc="delivery_customer.phone"/>
                    </div>
                    <div t-if="delivery_customer.email" style="font-size: 1.05em;">
                        <span>Email: </span><t t-esc="delivery_customer.email"/>
                    </div>
                </div>
            </t>
        </xpath>
    </t>
</templates>
