<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Adds "Factura Concepto" to the post-payment screen, below the print
        and send-receipt controls, where it lived in 18.0.

        The receipt-options container is point_of_sale.ReceiptScreen's own
        (receipt_screen.xml:21 on 19.0).
    -->
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]" position="inside">
            <button t-if="isConceptInvoiceAvailable"
                    class="button btn btn-lg btn-primary w-100 py-3"
                    t-on-click="() => this.clickConceptInvoice()">
                <i class="fa fa-file-text-o me-1" role="img"
                   aria-label="Factura Concepto"
                   title="Factura Concepto"/>
                Factura Concepto
            </button>
        </xpath>
    </t>

</templates>
