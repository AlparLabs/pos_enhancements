<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- ── Button component template ─────────────────────────────────────── -->
    <t t-name="pos_concept_invoice.ConceptInvoiceButton" owl="1">
        <button
            class="btn btn-secondary btn-lg concept-invoice-btn"
            t-att-class="{ disabled: isDisabled }"
            t-att-disabled="isDisabled"
            t-on-click="() => this.click()"
        >
            <i class="fa fa-file-text-o me-2"/>
            <span>Factura Concepto</span>
        </button>
    </t>

    <!-- ── Inject into PaymentScreenButtons ─────────────────────────────────
         Verified against Community 18.0 payment_screen.xml:
           Line 97:  <div class="payment-buttons d-flex flex-column gap-2">
           Line 98:    <div class="d-flex flex-column flex-sm-row gap-2 w-100">
           Line 109:     <button class="button js_invoice ...">
           Line 115:  <div t-if="...optional buttons...">
         We add ConceptInvoiceButton as a new row inside payment-buttons,
         after the first inner div that contains partner + js_invoice buttons.
    ─────────────────────────────────────────────────────────────────────── -->
    <t t-name="pos_concept_invoice.PaymentScreenButtons"
       t-inherit="point_of_sale.PaymentScreenButtons"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('payment-buttons')]/div[hasclass('d-flex')]" position="after">
            <ConceptInvoiceButton/>
        </xpath>
    </t>

</templates>
