<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!--
        Extend the ClosePosPopup footer to add the "Shift Change" button.

        The button is injected BEFORE the "Close Register" / "Discard" row so
        it appears as a distinct, prominent action at the top of the footer.
        It is only rendered when `showShiftChangeButton` is true (feature flag
        enabled on this POS + at least one draft order exists).
    -->
    <t t-name="pos_shift_change.ClosePosPopupPatch"
       t-inherit="point_of_sale.ClosePosPopup"
       t-inherit-mode="extension">

        <xpath expr="//t[@t-set-slot='footer']/div" position="before">
            <div t-if="showShiftChangeButton" class="w-100 mb-2">
                <button
                    class="btn btn-warning w-100 fw-bold"
                    t-on-click="onShiftChangeClick"
                    title="Close session and transfer open table orders to the next shift"
                >
                    <i class="fa fa-exchange me-2" role="img" aria-label="Shift Change"/>
                    Cambio de Turno
                </button>
            </div>
        </xpath>

    </t>
</templates>
