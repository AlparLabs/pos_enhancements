#. module: pos_shift_change
#: model_terms:ir.ui.view,arch_db:pos_shift_change.res_config_settings_view_form_shift_change
msgid "Allow closing the session while transferring open (draft) table orders to the next shift instead of cancelling them."
msgstr "Permite cerrar la sesión transfiriendo las órdenes abiertas (mesas en borrador) al siguiente turno en lugar de cancelarlas."

