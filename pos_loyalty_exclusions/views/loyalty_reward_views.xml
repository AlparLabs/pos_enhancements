<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_reward_view_form_inherit_exclusions" model="ir.ui.view">
        <field name="name">loyalty.reward.view.form.inherit.exclusions</field>
        <field name="model">loyalty.reward</field>
        <field name="inherit_id" ref="loyalty.loyalty_reward_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='discount_product_tag_id']" position="after">
                <separator string="Exclusiones de Retail / Margen" colspan="2"/>
                <field name="excluded_product_category_ids" widget="many2many_tags" placeholder="Categorías excluidas (ej. Cigarrillos, Telefonía, Precios Cuidados)"/>
                <field name="excluded_product_ids" widget="many2many_tags" placeholder="Productos específicos excluidos"/>
                <field name="exclude_already_discounted"/>
            </xpath>
        </field>
    </record>
</odoo>
