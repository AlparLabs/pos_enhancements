<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="loyalty_rule_view_form_inherit_exclusions" model="ir.ui.view">
        <field name="name">loyalty.rule.view.form.inherit.exclusions</field>
        <field name="model">loyalty.rule</field>
        <field name="inherit_id" ref="loyalty.loyalty_rule_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tag_id']" position="after">
                <separator string="Exclusiones de Productos" colspan="2"/>
                <field name="excluded_product_category_ids" widget="many2many_tags" placeholder="Categorías excluidas (ej. Cigarrillos, Telefonía)"/>
                <field name="excluded_product_ids" widget="many2many_tags" placeholder="Productos específicos excluidos"/>
            </xpath>
        </field>
    </record>
</odoo>
