<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_pos_order_form_inherit_scrap" model="ir.ui.view">
        <field name="name">pos.order.form.inherit.scrap</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_scrap"
                    type="object"
                    class="oe_stat_button"
                    icon="oi-arrows-v"
                    invisible="scrap_count == 0">
                    <field name="scrap_count" widget="statinfo" string="Desechos"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='lines']/list//field[@name='qty']" position="after">
                <field name="is_scrap_refund" string="Merma" optional="show" widget="boolean"/>
            </xpath>
        </field>
    </record>
</odoo>
