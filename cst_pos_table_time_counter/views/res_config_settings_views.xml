<?xml version="1.0"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_pos" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="inside">
                <setting name="Enable Table Timer"
                         help="Track table duration and compute total stay time in POS Restaurant.">
                    <field name="pos_enable_table_timer"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
