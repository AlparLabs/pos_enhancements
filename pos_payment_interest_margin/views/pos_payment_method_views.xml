<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_inherit_interest" model="ir.ui.view">
        <field name="name">pos.payment.method.form.inherit.interest</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='journal_id']" position="after">
                <field name="interest_margin_pct"/>
                <field name="interest_product_id" invisible="interest_margin_pct == 0.0" required="interest_margin_pct != 0.0"/>
            </xpath>
        </field>
    </record>
</odoo>
