<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_card_details.ClosingReceipt" t-inherit="point_of_sale.ClosingReceipt" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-amount') and contains(., 'Payments')]" position="after">
            <t t-if="props.data.card_details_by_payment_method and props.data.card_details_by_payment_method.length > 0">
                <br/>
                <div class="pos-receipt-title">
                    Card Transactions
                </div>
                <t t-foreach="props.data.card_details_by_payment_method" t-as="pm" t-key="pm.name">
                    <div class="pos-receipt-amount">
                        <t t-esc="pm.name"/>
                    </div>
                    <t t-foreach="pm.transactions" t-as="tx" t-key="tx.lot_number + '_' + tx.coupon_number">
                        <div style="font-size: 80%; margin-left: 10px; margin-bottom: 5px;">
                            <div>Amount: <t t-esc="env.utils.formatCurrency(tx.amount)" /></div>
                            <t t-if="tx.lot_number">
                                <div>Lot: <t t-esc="tx.lot_number"/></div>
                            </t>
                            <t t-if="tx.coupon_number">
                                <div>Coupon: <t t-esc="tx.coupon_number"/></div>
                            </t>
                            <t t-if="tx.installments and tx.installments > 1">
                                <div>Installs: <t t-esc="tx.installments"/></div>
                            </t>
                        </div>
                    </t>
                </t>
            </t>
        </xpath>
    </t>
</templates>
