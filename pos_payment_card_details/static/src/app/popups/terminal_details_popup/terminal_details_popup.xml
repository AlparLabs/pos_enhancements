<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_card_details.TerminalDetailsPopup">
        <Dialog title="props.title">
            <div class="d-flex flex-column gap-3 p-2">
                <div class="d-flex align-items-center gap-3">
                    <label class="fw-bold fs-5 w-25 text-start" for="lot_number_input">Lote:</label>
                    <input id="lot_number_input" type="text" class="form-control" t-model="state.lot_number" placeholder="Nro Lote"/>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <label class="fw-bold fs-5 w-25 text-start" for="coupon_number_input">Cupón:</label>
                    <input id="coupon_number_input" type="text" class="form-control" t-model="state.coupon_number" placeholder="Nro Cupón"/>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <label class="fw-bold fs-5 w-25 text-start" for="installments_input">Cuotas:</label>
                    <input id="installments_input" type="number" class="form-control" t-model="state.installments" min="1"/>
                </div>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary btn-lg" t-on-click="cancel">Cancelar</button>
                <button class="btn btn-primary btn-lg" t-on-click="confirm">Aceptar</button>
            </t>
        </Dialog>
    </t>
</templates>
