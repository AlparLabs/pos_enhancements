<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_card_details.TerminalDetailsPopup">
        <div class="popup popup-textinput">
            <div class="modal-header">
                <h4 class="modal-title title"><t t-esc="props.title" /></h4>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-column gap-3 mx-4 my-2">
                    <div class="d-flex align-items-center">
                        <label class="fw-bold fs-5 w-50 text-start">Lote:</label>
                        <input type="text" class="form-control" t-model="state.lot_number" placeholder="Nro Lote"/>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="fw-bold fs-5 w-50 text-start">Cupón:</label>
                        <input type="text" class="form-control" t-model="state.coupon_number" placeholder="Nro Cupón"/>
                    </div>
                    <div class="d-flex align-items-center">
                        <label class="fw-bold fs-5 w-50 text-start">Cuotas:</label>
                        <input type="number" class="form-control" t-model="state.installments" min="1"/>
                    </div>
                </div>
            </div>
            <div class="footer footer-flex">
                <div class="button highlight btn btn-lg btn-primary" t-on-click="confirm">
                    Aceptar
                </div>
                <div class="button btn btn-lg btn-secondary" t-on-click="cancel">
                    Cancelar
                </div>
            </div>
        </div>
    </t>
</templates>
