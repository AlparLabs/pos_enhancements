<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_payment_card_details.TerminalDetailsPopup">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><t t-esc="props.title"/></h5>
                </div>
                <div class="modal-body">
                    <div class="d-flex flex-column gap-3 p-2">
                        <div class="d-flex align-items-center gap-3">
                            <label class="fw-bold fs-5 w-25 text-start">Lote:</label>
                            <input type="text" class="form-control" t-model="state.lot_number" placeholder="Nro Lote"/>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <label class="fw-bold fs-5 w-25 text-start">Cupón:</label>
                            <input type="text" class="form-control" t-model="state.coupon_number" placeholder="Nro Cupón"/>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <label class="fw-bold fs-5 w-25 text-start">Cuotas:</label>
                            <input type="number" class="form-control" t-model="state.installments" min="1"/>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary btn-lg" t-on-click="cancel">Cancelar</button>
                    <button class="btn btn-primary btn-lg" t-on-click="confirm">Aceptar</button>
                </div>
            </div>
        </div>
    </t>
</templates>
