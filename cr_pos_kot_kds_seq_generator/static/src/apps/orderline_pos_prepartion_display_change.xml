<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t t-name="pos_preparation_display.Orderline" t-inherit="pos_preparation_display.Orderline"
       t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_pdis_orderline_infos')]" position="before">
            <t t-if="this.props.orderline.kot_note">
                <p style="background-color: #d8b1b1; margin:2px; padding-left:25px;"
                   t-esc="this.props.orderline.kot_note"/>
            </t>

        </xpath>
    </t>
</templates>