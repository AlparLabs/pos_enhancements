<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <!--
        XPath patch on the kiosk PaymentPage template.

        Replaces the Back button's click handler so that when a Mercado Pago
        payment is in progress (_mpPolling = true), pressing "Back" calls
        cancelMercadoPagoPayment() instead of router.back(). This ensures the
        pending MP order is cancelled before the kiosk navigates away.

        When _mpPolling is false, the original router.back() behaviour is preserved.
    -->
    <t t-inherit="pos_self_order.PaymentPage" t-inherit-mode="extension">
        <xpath expr="//button[contains(@class,'btn-primary')]" position="before">
            <t t-if="_mpQrData">
                <div class="mp-kiosk-qr-container d-flex flex-column align-items-center justify-content-center p-4 bg-white rounded shadow-sm mb-4">
                    <h2 class="mb-3 text-primary">Scan to Pay</h2>
                    <img t-attf-src="/report/barcode/?barcode_type=QR&amp;value={{ _mpQrData }}&amp;width=256&amp;height=256" alt="Mercado Pago QR Code" class="img-fluid" style="width: 256px; height: 256px;"/>
                    <p class="mt-3 text-muted text-center" style="font-size: 1.2rem;">
                        Waiting for payment confirmation directly from your Mercado Pago app...
                    </p>
                </div>
            </t>
        </xpath>
        <xpath expr="//button[contains(@class,'btn-primary')]" position="replace">
            <button
                class="btn btn-primary btn-lg"
                t-if="state.selection or selectedPaymentMethod.is_online_payment or selfOrder.paymentError or _mpPolling"
                t-on-click="() => _mpPolling ? cancelMercadoPagoPayment() : router.back()"
            >Back</button>
        </xpath>
    </t>
</templates>
