<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Argentine invoice header (document type, number, CUIT, responsibility).
        In Odoo 19 the `pos-receipt-contact` block lives in the ReceiptHeader
        sub-component, not in OrderReceipt, so we must inherit it here.
    -->
    <t t-name="pos_l10n_ar_receipt.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="after">
            <t t-if="isSupermarketReceipt">
                <div class="pos-supermarket-header text-center">
                    <div class="pos-supermarket-copy-label">
                        <t t-esc="props.l10nArCopyLabel or 'ORIGINAL'"/>
                    </div>
                    <div class="pos-supermarket-doc-title">
                        <t t-esc="supermarketHeaderData.docType"/> (Cod.<t t-esc="supermarketHeaderData.docCode"/>)
                    </div>
                    <div class="pos-supermarket-partner-resp">
                        <t t-esc="supermarketHeaderData.partnerResp"/>
                    </div>

                    <div class="pos-supermarket-divider"/>

                    <div class="pos-supermarket-meta-grid">
                        <div class="d-flex justify-content-between">
                            <span>P.V. Nro.: <t t-esc="supermarketHeaderData.pv"/></span>
                            <span>Nro T. <t t-esc="supermarketHeaderData.ticketNum"/></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Fecha <t t-esc="supermarketHeaderData.dateStr"/></span>
                            <span>Hora <t t-esc="supermarketHeaderData.timeStr"/></span>
                        </div>
                        <div class="d-flex justify-content-between">
                            <span>Caja <t t-esc="supermarketHeaderData.caja"/></span>
                            <span>Cajero/a: <t t-esc="supermarketHeaderData.cajero"/></span>
                        </div>
                    </div>

                    <div class="pos-supermarket-divider"/>
                </div>
            </t>
            <t t-else="">
                <div t-if="order.l10n_ar_document_type_name" class="pos-receipt-center-align" style="font-weight: bold; margin-top: 5px;">
                    <t t-esc="order.l10n_ar_document_type_name"/> - <t t-esc="props.l10nArCopyLabel or 'ORIGINAL'"/> - COD (<t t-esc="order.l10n_ar_document_type_code"/>)
                </div>
                <div t-if="order.l10n_latam_document_number" class="pos-receipt-center-align" style="font-weight: bold;">
                    Nº DE FACTURA: <t t-esc="order.l10n_latam_document_number"/>
                </div>
                <div t-if="order.l10n_ar_company_cuit" class="pos-receipt-center-align" style="font-size: 0.9em;">
                    CUIT: <t t-esc="order.l10n_ar_company_cuit"/>
                </div>
                <div t-if="order.l10n_ar_company_responsibility" class="pos-receipt-center-align" style="font-size: 0.9em; margin-bottom: 5px;">
                    <t t-esc="order.l10n_ar_company_responsibility"/>
                </div>
            </t>
        </xpath>

        <!--
            Emphasize ticket number, date/time and cashier (bold + larger),
            matching the pre-ticket style. These sit inside a 75% font-size
            container, so the em sizes below render clearly bigger than the
            surrounding header text. The ticket number stays smaller than
            "Nº DE FACTURA" above so cashiers don't confuse the two.
        -->
        <xpath expr="//span[hasclass('pos-receipt-vat')]" position="attributes">
            <attribute name="style">font-weight: bold; font-size: 1.1em;</attribute>
        </xpath>
        <xpath expr="//div[@id='order-date']" position="attributes">
            <attribute name="style">font-weight: bold; font-size: 1.4em;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('cashier')]" position="attributes">
            <attribute name="style">font-weight: bold; font-size: 1.4em;</attribute>
        </xpath>
    </t>

    <t t-name="pos_l10n_ar_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">

        <!-- Forward the copy label (ORIGINAL/DUPLICADO) down to the header. -->
        <xpath expr="//ReceiptHeader" position="attributes">
            <attribute name="l10nArCopyLabel">props.l10nArCopyLabel</attribute>
        </xpath>

        <!-- Apply supermarket receipt class to root container if active -->
        <xpath expr="//div[hasclass('pos-receipt')]" position="attributes">
            <attribute name="t-att-class">{'pos-supermarket-receipt': isSupermarketReceipt}</attribute>
        </xpath>

        <!-- Supermarket Lines (grouped by category) before OrderDisplay -->
        <xpath expr="//OrderDisplay" position="before">
            <t t-if="isSupermarketReceipt">
                <div class="pos-supermarket-lines">
                    <t t-foreach="supermarketData.groups" t-as="group" t-key="group.name">
                        <div class="pos-supermarket-category-title">
                            <t t-esc="group.name"/>
                        </div>
                        <t t-foreach="group.lines" t-as="item" t-key="item.line.uuid">
                            <div class="pos-supermarket-item">
                                <div class="pos-supermarket-item-name">
                                    <t t-esc="item.name"/>
                                </div>
                                <div class="d-flex justify-content-between pos-supermarket-item-calc">
                                    <span>
                                        <t t-esc="item.qtyStr"/> x <t t-esc="item.unitPriceStr"/> (<t t-esc="item.taxRateStr"/>)
                                    </span>
                                    <span class="pos-receipt-right-align">
                                        <t t-esc="item.subtotalStr"/>
                                    </span>
                                </div>
                                <div t-if="item.hasDiscount" class="d-flex justify-content-between pos-supermarket-item-discount">
                                    <span class="ps-2 text-muted">
                                        <t t-esc="item.discountName"/>
                                    </span>
                                    <span class="pos-receipt-right-align text-muted">
                                        -<t t-esc="item.discountStr"/>
                                    </span>
                                </div>
                                <div t-if="item.barcode" class="pos-supermarket-barcode">
                                    <t t-esc="item.barcode"/>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </t>
        </xpath>

        <!-- Supermarket Totals, Discounts & Savings Block before pos-receipt-amount -->
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="before">
            <t t-if="isSupermarketReceipt">
                <div class="pos-supermarket-totals-block">
                    <div class="pos-supermarket-divider"/>
                    <div class="d-flex justify-content-between pos-supermarket-subtotal-row">
                        <span class="fw-bold">SUBTOTAL SIN DESCUENTOS</span>
                        <span class="pos-receipt-right-align fw-bold">
                            $ <t t-esc="supermarketData.subtotalWithoutDiscountsStr"/>
                        </span>
                    </div>
                    <div class="pos-supermarket-divider"/>

                    <t t-if="supermarketData.hasDiscounts">
                        <div class="pos-supermarket-discounts-title fw-bold">
                            DESCUENTOS
                        </div>
                        <t t-foreach="supermarketData.discounts" t-as="disc" t-key="disc.name + disc_index">
                            <div class="d-flex justify-content-between pos-supermarket-discount-row">
                                <span class="ps-2"><t t-esc="disc.name"/></span>
                                <span class="pos-receipt-right-align">-<t t-esc="disc.amountStr"/></span>
                            </div>
                        </t>
                        <div class="d-flex justify-content-between pos-supermarket-ahorro-row fw-bold" style="margin-top: 4px;">
                            <span>AHORRO</span>
                            <span class="pos-receipt-right-align">
                                $ <t t-esc="supermarketData.totalSavingsStr"/>
                            </span>
                        </div>
                        <div class="pos-supermarket-divider"/>
                    </t>

                    <div class="d-flex justify-content-between pos-supermarket-total-row fw-bold" style="font-size: 1.25em; margin: 4px 0;">
                        <span>TOTAL</span>
                        <span class="pos-receipt-right-align">
                            $ <t t-esc="supermarketTotalStr"/>
                        </span>
                    </div>
                    <div class="pos-supermarket-divider"/>
                </div>
            </t>
        </xpath>

        <!-- ARCA (AFIP) QR Code and CAE details -->
        <xpath expr="//div[hasclass('before-footer')]" position="after">
            <div class="pos-l10n-ar-receipt" style="font-size: 0.8em; margin-top: 10px; border-top: 1px dashed black; padding-top: 10px;">

                <!-- QR Code
                     order.l10n_ar_afip_qr_code is a full ARCA URL (e.g.
                     "https://www.afip.gob.ar/fe/qr/?p=<base64>"). It must be
                     passed as the `value` query param (URL-encoded), not
                     concatenated into the path: an unencoded "?" would be
                     read as the start of this request's own query string,
                     stripping the "p=" payload and leaving the QR pointing
                     at ARCA's landing page with no invoice data encoded.
                     encodeURIComponent is a JS global, not callable from an
                     OWL template, so the src is built by the component
                     method l10nArQrCodeSrc (receipt_components_patch.js). -->
                <div t-if="order.l10n_ar_afip_qr_code" class="pos-receipt-center-align" style="margin-bottom: 5px;">
                    <img t-att-src="l10nArQrCodeSrc(order.l10n_ar_afip_qr_code)" style="width: 200px; height: 200px;" alt="QR Code ARCA"/>
                </div>

                <!-- CAE Details -->
                <div t-if="order.l10n_ar_afip_auth_code" class="pos-receipt-center-align" style="font-weight: bold;">
                    CAE: <t t-esc="order.l10n_ar_afip_auth_code"/>
                </div>
                <div t-if="order.l10n_ar_afip_auth_code_due" class="pos-receipt-center-align">
                    Vencimiento CAE: <t t-esc="order.l10n_ar_afip_auth_code_due"/>
                </div>

            </div>
        </xpath>

        <!--
            Fiscal Transparency Regime: on B/C/X/R documents the price already
            includes VAT, so the Subtotal + tax-group breakdown must not be
            printed — only the total and the disclosure block below it. The
            letters match core's account.move._l10n_ar_include_vat(), which
            drives the same rule on the PDF invoice report.

            Overriding the t-if via position="attributes" rather than replacing
            the whole block keeps core's markup, so upstream changes to the tax
            rows are inherited instead of frozen at this version.
        -->
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="attributes">
            <attribute name="t-if">taxTotals and taxTotals.has_tax_groups and !['B', 'C', 'X', 'R'].includes(order.l10n_ar_letter)</attribute>
        </xpath>

        <!-- Optional: Breakdown of taxes if it's Factura A -->
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="after">
            <div t-if="order.l10n_ar_letter === 'A' and order.l10n_ar_tax_details and order.l10n_ar_tax_details.length" class="pos-receipt-taxes" style="font-size: 0.8em; margin-top: 5px;">
                <t t-foreach="order.l10n_ar_tax_details" t-as="tax" t-key="tax_index">
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="tax.name"/></span>
                        <span><t t-esc="formatCurrency(tax.amount)"/></span>
                    </div>
                </t>
            </div>

            <!--
                Fiscal Transparency Regime (Law 27.743 / RG 5614-2024): B and C
                invoices show the price with VAT included, so the VAT content and
                other national indirect taxes have to be disclosed separately.
                order.l10n_ar_custom_tax_summary is computed server-side by core's
                _l10n_ar_get_invoice_custom_tax_summary_for_report(), which already
                returns an empty list for A invoices, so no letter check is needed
                here. Amounts arrive pre-formatted in the invoice currency.
            -->
            <div t-if="order.l10n_ar_custom_tax_summary and order.l10n_ar_custom_tax_summary.length"
                 class="pos-receipt-ar-transparency"
                 style="font-size: 0.8em; margin-top: 10px; border-top: 1px dashed black; padding-top: 5px;">
                <div class="pos-receipt-center-align"
                     style="font-weight: bold; margin-bottom: 5px; padding-bottom: 5px; border-bottom: 1px solid black;">
                    Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)
                </div>
                <t t-foreach="order.l10n_ar_custom_tax_summary" t-as="detail" t-key="detail.name">
                    <div class="d-flex justify-content-between">
                        <span t-esc="detail.name"/>
                        <span t-esc="detail.formatted_tax_amount_currency"/>
                    </div>
                </t>
            </div>
        </xpath>

    </t>

    <!--
        Prepend the product's internal reference (default_code) in bold before
        its name, but only when this Orderline instance is being rendered in
        receipt mode (mode="receipt", set explicitly by OrderReceipt) and the
        per-POS toggle is enabled. OrderReceipt renders both the on-screen
        receipt preview (ReceiptScreen) and the actual printed/emailed
        receipt — both are "the receipt" for this feature's purposes. The
        live product-screen cart (mode="display") is untouched.
    -->
    <t t-name="pos_l10n_ar_receipt.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-wrap')]/t[@t-esc='vals.name']" position="before">
            <span t-if="props.mode === 'receipt' and line.config.l10n_ar_show_product_reference and line.product_id.default_code"
                  class="fw-bolder pe-1"
                  t-esc="line.product_id.default_code"/>
        </xpath>
    </t>

</templates>
