<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_l10n_ar_receipt.OrderReceipt" t-inherit="point_of_sale.OrderReceipt" t-inherit-mode="extension">
        
        <!-- Add Argentine Invoice Header -->
        <xpath expr="//ReceiptHeader" position="after">
            <t t-if="props.data.l10n_latam_document_type_name">
                <div class="pos-receipt-center-align" style="font-weight: bold; margin-top: 10px; font-size: 1.2em; text-transform: uppercase; border-top: 2px solid black; padding-top: 5px;">
                    <t t-esc="props.data.l10n_latam_document_type_name.replace('Facturas', 'Factura')"/>
                </div>
                
                <div class="pos-l10n-ar-header-info" style="font-size: 0.85em; margin-bottom: 10px; border-bottom: 2px solid black; padding-bottom: 5px;">
                    <!-- Document Number and Date -->
                    <div style="display: flex; justify-content: space-between; font-weight: bold; margin-top: 5px;">
                        <span>Nro: <t t-esc="props.data.l10n_latam_document_number"/></span>
                        <span>Fecha: <t t-esc="props.data.l10n_ar_invoice_date || props.data.date"/></span>
                    </div>

                    <div style="margin-top: 10px; border-top: 1px dashed #ccc; padding-top: 5px;">
                        <div style="font-weight: bold; text-decoration: underline; margin-bottom: 3px;">EMISOR:</div>
                        <div style="font-weight: bold;"><t t-esc="props.data.headerData.company.name"/></div>
                        <div><t t-esc="props.data.l10n_ar_company_address"/></div>
                        <div>CUIT: <t t-esc="props.data.l10n_ar_company_cuit"/></div>
                        <div>Cond. IVA: <t t-esc="props.data.l10n_ar_company_responsibility"/></div>
                        <div t-if="props.data.l10n_ar_company_iibb">IIBB: <t t-esc="props.data.l10n_ar_company_iibb"/></div>
                        <div t-if="props.data.l10n_ar_company_start_date">Inicio Act: <t t-esc="props.data.l10n_ar_company_start_date"/></div>
                    </div>

                    <div style="margin-top: 10px; border-top: 1px dashed #ccc; padding-top: 5px;">
                        <div style="font-weight: bold; text-decoration: underline; margin-bottom: 3px;">RECEPTOR:</div>
                        <div style="font-weight: bold;"><t t-esc="props.data.l10n_ar_partner_name"/></div>
                        <div t-if="props.data.l10n_ar_partner_vat">CUIT/DNI: <t t-esc="props.data.l10n_ar_partner_vat"/></div>
                        <div t-if="props.data.l10n_ar_partner_responsibility">Cond. IVA: <t t-esc="props.data.l10n_ar_partner_responsibility"/></div>
                        <div t-if="props.data.l10n_ar_partner_address"><t t-esc="props.data.l10n_ar_partner_address"/></div>
                    </div>
                </div>
            </t>
        </xpath>

        <!-- AFIP QR Code and CAE Details -->
        <xpath expr="//div[hasclass('pos-receipt-order-data')]" position="before">
            <div class="pos-l10n-ar-receipt" style="font-size: 0.8em; margin-top: 10px; border-top: 1px dashed black; padding-top: 10px;">
                
                <!-- QR Code -->
                <div t-if="props.data.l10n_ar_afip_qr_code" class="pos-receipt-center-align" style="margin-bottom: 5px;">
                    <img t-att-src="'/report/barcode/QR/' + props.data.l10n_ar_afip_qr_code" style="width: 160px; height: 160px;" alt="QR Code AFIP"/>
                </div>

                <!-- CAE Details -->
                <div t-if="props.data.l10n_ar_afip_auth_code" class="pos-receipt-center-align" style="font-weight: bold; font-size: 1.1em;">
                    CAE: <t t-esc="props.data.l10n_ar_afip_auth_code"/>
                </div>
                <div t-if="props.data.l10n_ar_afip_auth_code_due" class="pos-receipt-center-align">
                    Vencimiento CAE: <t t-esc="props.data.l10n_ar_afip_auth_code_due"/>
                </div>

            </div>
        </xpath>

        <!-- Optional: Breakdown of taxes if it's Factura A -->
        <xpath expr="//div[hasclass('pos-receipt-amount')]" position="after">
            <div t-if="props.data.l10n_ar_letter === 'A' and props.data.l10n_ar_tax_details" class="pos-receipt-ar-taxes" style="font-size: 0.8em; margin-top: 5px;">
                <t t-foreach="props.data.l10n_ar_tax_details" t-as="tax" t-key="tax_index">
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="tax.name"/></span>
                        <span><t t-esc="props.formatCurrency(tax.amount)"/></span>
                    </div>
                </t>
            </div>

            <!-- Transparency Regime Logic for B (Law 27.743) -->
            <div t-if="props.data.l10n_ar_custom_tax_summary and props.data.l10n_ar_custom_tax_summary.length > 0" class="pos-receipt-ar-taxes" style="font-size: 0.8em; margin-top: 10px; border-top: 1px dashed black; padding-top: 5px;">
                <div style="font-weight: bold; text-align: center; margin-bottom: 5px; font-size: 0.9em; padding-bottom: 5px; border-bottom: 1px solid black;">
                    Régimen de Transparencia Fiscal al Consumidor (Ley 27.743)
                </div>
                <t t-foreach="props.data.l10n_ar_custom_tax_summary" t-as="detail" t-key="detail.name">
                    <div class="d-flex justify-content-between">
                        <span><t t-esc="detail.name"/></span>
                        <span><t t-esc="detail.formatted_tax_amount_currency"/></span>
                    </div>
                </t>
            </div>
        </xpath>

        <!-- Hide Subtotal + Taxes for Factura B/C -->
        <!-- We use a more aggressive approach to ensure standard blocks are hidden -->
        <xpath expr="//div[hasclass('pos-receipt-taxes')]" position="attributes">
            <attribute name="t-attf-style" add="display: {{ props.data.l10n_ar_letter === 'B' or props.data.l10n_ar_letter === 'C' ? 'none' : 'block' }}" separator=";"/>
        </xpath>

    </t>

    <!-- Hide standard ReceiptHeader elements for AFIP receipts -->
    <t t-name="pos_l10n_ar_receipt.ReceiptHeader" t-inherit="point_of_sale.ReceiptHeader" t-inherit-mode="extension">
        <xpath expr="//h1[hasclass('tracking-number')]" position="attributes">
            <attribute name="t-attf-class" add="{{ props.data.l10n_latam_document_type_name ? 'd-none' : '' }}" separator=" "/>
        </xpath>
        <xpath expr="//div[hasclass('pos-receipt-contact')]" position="attributes">
            <attribute name="t-attf-class" add="{{ props.data.l10n_latam_document_type_name ? 'd-none' : '' }}" separator=" "/>
        </xpath>
    </t>

</templates>

</templates>
