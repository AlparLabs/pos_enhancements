<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Mobile view: Add VAT after contact info -->
    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-line-email')]" position="inside">
            <div class="mb-1" t-if="props.partner.vat">
                <i class="fa fa-fw fa-id-card me-2"/>
                <span class="fw-bold text-primary"><t t-esc="props.partner.vat"/></span>
            </div>
        </xpath>
    </t>

    <!-- Desktop view: Add VAT column -->
    <t t-inherit="point_of_sale.PartnerLine" t-inherit-mode="extension">
        <xpath expr="//tr[hasclass('partner-line')]//td[hasclass('partner-line-email')]" position="after">
            <td class="partner-line-vat">
                <div t-if="props.partner.vat" class="d-flex align-items-center">
                    <i class="fa fa-fw fa-id-card me-2 text-muted"/>
                    <span class="fw-bold text-primary"><t t-esc="props.partner.vat"/></span>
                </div>
            </td>
        </xpath>
    </t>

</templates>
