<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
        Primary inheritance: creates a brand new template based on the standard
        Orderline, so the change only affects the pre-ticket and never the
        regular POS receipt. Adds the product internal reference (default_code)
        in bold right before the product name.
    -->
    <t t-name="pos_retail_pre_ticket.PreTicketOrderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="primary">
        <xpath expr="//span[hasclass('text-wrap')]/t[@t-esc='vals.name']" position="before">
            <span t-if="line.product_id and line.product_id.default_code" class="fw-bolder pe-1" t-esc="line.product_id.default_code"/>
        </xpath>
    </t>

</templates>
