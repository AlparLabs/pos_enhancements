<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_retail_pre_ticket.PreTicketReceipt" owl="1">
        <t t-set="order" t-value="props.order"/>
        <div class="pos-receipt pre-ticket-receipt">

            <ReceiptHeader order="order"/>

            <div class="pos-receipt-center-align" style="font-weight: bold; font-size: 1.5em; margin-top: 10px; margin-bottom: 5px;">
                PRE-TICKET
            </div>
            <div class="pos-receipt-center-align" style="margin-bottom: 10px;">
                No válido como factura
            </div>

            <br/>
            <div t-if="order.partner_id" class="pos-receipt-contact">
                Cliente: <t t-esc="order.partner_id.name"/><br/>
            </div>
            <br/>

            <!-- Orderlines -->
            <div class="orderlines">
                <t t-foreach="order.lines" t-as="line" t-key="line.uuid">
                    <Orderline line="line" mode="'receipt'"/>
                </t>
            </div>

            <!-- Subtotal + taxes (only shown when tax is not included in price) -->
            <t t-set="taxTotals" t-value="order.prices.taxDetails"/>
            <t t-if="taxTotals and taxTotals.has_tax_groups">
                <div class="pos-receipt-right-align">--------</div>
                <br/>
                <div class="d-flex">
                    <span>Subtotal</span>
                    <span t-esc="formatCurrency(order.priceExcl)" class="pos-receipt-right-align"/>
                </div>
                <t t-foreach="taxTotals.subtotals" t-as="subtotal" t-key="subtotal.name">
                    <t t-foreach="subtotal.tax_groups" t-as="tax_group" t-key="tax_group.id">
                        <div class="responsive-price">
                            <t t-esc="tax_group.group_name"/>
                            <span t-esc="formatCurrency(tax_group.tax_amount_currency)" class="pos-receipt-right-align"/>
                        </div>
                    </t>
                </t>
            </t>

            <!-- Total -->
            <div class="pos-receipt-right-align">--------</div>
            <br/>
            <div class="pos-receipt-amount">
                TOTAL
                <span t-esc="formatCurrency(order.priceIncl)" class="pos-receipt-right-align"/>
            </div>
            <br/>

            <!-- Order barcode -->
            <div t-if="order.name" class="pos-receipt-center-align">
                <br/>
                <img t-att-src="'/report/barcode/Code128/' + order.name" style="width:250px; height:50px;" alt="Barcode"/>
                <br/>
                <t t-esc="order.name"/>
            </div>

        </div>
    </t>
</templates>
